{
  "manifest_version": 3,
  "name": "B站推荐过滤器",
  "version": "7.0.0",
  "description": "Bilibili首页推荐过滤器：智能屏蔽广告、分类、直播和自定义关键词，支持自适应持续屏蔽、拖拽控制面板、暗黑模式切换，以及修复屏蔽后页面留白问题。优化UI交互，提升浏览体验。",
  "icons": {
    "128": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["*://www.bilibili.com/*"],
      "exclude_matches": ["*://www.bilibili.com/video/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": ["storage"]
}